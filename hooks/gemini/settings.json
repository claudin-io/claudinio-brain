{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "claudinio-brain",
            "description": "Say what this project's brain is and what it holds.",
            "command": "/ABSOLUTE/PATH/TO/brain hook context",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "claudinio-brain",
            "description": "Answer the prompt from the brain before the agent plans.",
            "command": "/ABSOLUTE/PATH/TO/brain hook recall",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
