{
  "description": "claudinio-brain: read the project's brain on every prompt, without being asked.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/brain hook context",
            "timeout": 15,
            "statusMessage": "Reading this project's brain"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/brain hook recall",
            "timeout": 10,
            "statusMessage": "Asking the brain"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/brain hook flush",
            "timeout": 10,
            "statusMessage": "Asking for anything worth keeping"
          }
        ]
      }
    ]
  }
}
